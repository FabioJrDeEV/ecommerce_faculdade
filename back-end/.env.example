# === Backend - Exemplo de variáveis de ambiente ===
# Copie este arquivo para .env e preencha com os valores reais.

# Banco de dados PostgreSQL (Neon, Supabase, RDS, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT — gere um valor longo e aleatório para produção (ex: openssl rand -base64 32)
JWT_SECRET="GERE_UM_SEGREDO_FORTE_AQUI"
JWT_EXPIRES_IN="7d"

# Porta do servidor
PORT="3333"

# URL(s) do frontend para CORS — separe múltiplas origens por vírgula
FRONT_URL="https://seudominio.com"

# === Stripe ===
# sk_live_... para produção, sk_test_... para testes
STRIPE_SECRET_KEY="sk_live_SUA_CHAVE_AQUI"
# Configurado no dashboard da Stripe: Developers > Webhooks > Add endpoint
STRIPE_SUCCESS_URL="https://seudominio.com/cart?sucesso=1"
STRIPE_CANCEL_URL="https://seudominio.com/cart?cancelado=1"
STRIPE_WEBHOOK_SECRET="whsec_SEU_WEBHOOK_SECRET_AQUI"

# === Porta que o servidor escuta ===
HOST="0.0.0.0"
